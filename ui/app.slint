import { LineEdit, Palette, ScrollView } from "std-widgets.slint";

export struct ResetCreditView {
    id: string,
    title: string,
    expiry: string,
}

export struct AccountView {
    id: string,
    provider-id: string,
    display-name: string,
    masked-display-name: string,
    color-name: string,
    custom-color: bool,
    account-color: color,
    email: string,
    masked-email: string,
    accent: color,
    show-accent: bool,
    enabled: bool,
    pin-short: bool,
    expanded: bool,
    name-revealed: bool,
    email-revealed: bool,
    confirm-credit-id: string,
    has-usage: bool,
    has-error: bool,
    error-text: string,
    long-label: string,
    long-remaining: float,
    long-percent-text: string,
    has-long-reset-time: bool,
    long-reset-text: string,
    long-reset-color: color,
    has-short-limit: bool,
    short-label: string,
    short-remaining: float,
    short-percent-text: string,
    has-short-reset-time: bool,
    short-reset-text: string,
    short-reset-color: color,
    has-reset-credits: bool,
    reset-count-text: string,
    reset-credits: [ResetCreditView],
    has-hidden-details: bool,
    detail-height-px: float,
    row-height-px: float,
}

export struct ColorChoice {
    name: string,
    value: color,
}

export struct MobileDeviceView {
    id: string,
    name: string,
    detail: string,
}

export struct QrCell {
    x: float,
    y: float,
    size: float,
}

component AccentDot inherits Rectangle {
    in property <color> accent;
    background: root.accent;
    border-color: Palette.border;
    border-width: 1px;
    border-radius: root.width / 2;
}

component AppSwitch inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    width: 38px;
    height: 22px;
    background: transparent;
    forward-focus: focus-scope;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-action-default => { root.toggle(); }

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    rail := Rectangle {
        x: 0px;
        y: 1px;
        width: parent.width;
        height: 20px;
        border-radius: 10px;
        border-width: root.checked ? 0px : 1px;
        border-color: Palette.border;
        background: root.checked ? Palette.foreground : Palette.alternate-background;
        opacity: root.enabled ? (area.has-hover ? 0.82 : 1) : 0.4;
    }

    thumb := Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        y: 5px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked ? Palette.background : Palette.foreground;
        opacity: root.enabled ? 1 : 0.5;
        animate x { duration: 120ms; easing: ease-out; }
    }

    if focus-scope.has-focus: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: 13px;
        border-width: 1px;
        border-color: Palette.foreground;
        background: transparent;
        opacity: 0.55;
    }

    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggle(); }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.toggle();
                return accept;
            }
            return reject;
        }
    }
}

component ProviderMark inherits Rectangle {
    in property <string> provider-id: "openai";
    in property <color> accent;
    in property <bool> show-accent: true;
    width: 27px;
    height: 22px;
    background: transparent;

    if root.provider-id == "openai": Path {
        x: 1px;
        y: 2px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: white;
        fill-rule: evenodd;
        commands: "M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z";
    }

    if root.provider-id != "openai": Image {
        x: 1px;
        y: 2px;
        width: 18px;
        height: 18px;
        source: root.provider-id == "anthropic"
            ? @image-url("../assets/providers/anthropic.svg")
            : root.provider-id == "google"
            ? @image-url("../assets/providers/google.svg")
            : root.provider-id == "xai"
            ? @image-url("../assets/providers/xai.svg")
            : @image-url("../assets/providers/opencode.svg");
        colorize: white;
        image-fit: contain;
    }

    if root.show-accent: AccentDot {
        x: 19px;
        y: 14px;
        width: 8px;
        height: 8px;
        accent: root.accent;
    }
}

component HeaderIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> icon-size: 18px;
    in property <bool> active: true;
    callback clicked();
    width: 30px;
    height: 30px;
    background: root.active && area.has-hover ? Palette.alternate-background : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.active) { root.clicked(); } }
    opacity: root.active ? 1 : 0.36;

    Image {
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: Palette.foreground;
        image-fit: contain;
    }
    area := TouchArea {
        clicked => { if (root.active) { root.clicked(); } }
    }
}

component UsageBar inherits Rectangle {
    in property <float> remaining: 0;
    in property <color> fill-color;
    in property <string> accessible-name;
    in property <string> accessible-value-text;
    height: 5px;
    accessible-role: progress-indicator;
    accessible-label: root.accessible-name;
    accessible-value: root.accessible-value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    border-radius: 2.5px;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;

    Rectangle {
        x: 1px;
        y: 1px;
        width: max(0px, (parent.width - 2px) * min(1, max(0, root.remaining)));
        height: parent.height - 2px;
        border-radius: 1.5px;
        background: root.fill-color;
    }
}

component LimitLine inherits Rectangle {
    in property <string> label;
    in property <float> remaining;
    in property <string> percent-text;
    in property <color> accent;
    in property <string> reset-text: "";
    in property <color> reset-color: Palette.foreground;
    in property <bool> show-reset-text: false;
    in property <bool> color-reset-timer: false;
    height: 18px;
    background: transparent;

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 5px;
        HorizontalLayout {
            spacing: 0px;
            Text {
                text: root.label;
                color: Palette.foreground;
                font-size: 10px;
                opacity: 0.70;
                vertical-alignment: center;
            }
            if root.show-reset-text: Text {
                text: " • resets in ";
                color: Palette.foreground;
                font-size: 10px;
                opacity: 0.70;
                vertical-alignment: center;
            }
            if root.show-reset-text: Text {
                text: root.reset-text;
                color: root.color-reset-timer ? root.reset-color : Palette.foreground;
                font-size: 10px;
                font-weight: root.color-reset-timer ? 600 : 400;
                opacity: root.color-reset-timer ? 0.96 : 0.70;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 18px;
            horizontal-stretch: 1;
            background: transparent;
            UsageBar {
                y: 6.5px;
                width: parent.width;
                remaining: root.remaining;
                fill-color: root.accent;
                accessible-name: root.label + " remaining usage";
                accessible-value-text: root.percent-text + " remaining";
            }
        }
        Text {
            width: 34px;
            text: root.percent-text;
            color: Palette.foreground;
            font-size: 10.5px;
            font-weight: 600;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component Chevron inherits Rectangle {
    in property <bool> expanded: false;
    in property <bool> motion-enabled: true;
    width: 24px;
    height: 24px;
    background: transparent;
    Image {
        width: 16px;
        height: 16px;
        x: 4px;
        y: 4px;
        source: @image-url("../assets/icons/chevron-down.svg");
        colorize: Palette.foreground;
        image-fit: contain;
        transform-rotation: root.expanded ? 180deg : 0deg;
        animate transform-rotation {
            duration: 140ms;
            easing: ease-out;
            enabled: root.motion-enabled;
        }
    }
}

component TinyAction inherits Rectangle {
    in property <string> text;
    in property <bool> emphasized: false;
    in property <bool> active: true;
    callback clicked();
    height: 22px;
    background: root.emphasized
        ? #4f75ff
        : (root.active && area.has-hover ? Palette.alternate-background : transparent);
    border-width: root.emphasized ? 0px : 1px;
    border-color: Palette.border;
    border-radius: 5px;
    opacity: root.active ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.active) { root.clicked(); } }
    Text {
        text: root.text;
        color: root.emphasized ? white : Palette.foreground;
        font-size: 9.5px;
        font-weight: root.emphasized ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        clicked => { if (root.active) { root.clicked(); } }
    }
}

component DetailLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 18px;
    spacing: 8px;
    Text {
        text: root.label;
        color: Palette.foreground;
        font-size: 9.5px;
        opacity: 0.58;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: Palette.foreground;
        font-size: 9.5px;
        opacity: 0.84;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
}

component ResetCreditRow inherits Rectangle {
    in property <ResetCreditView> credit;
    in property <bool> confirming: false;
    in property <bool> busy: false;
    callback use-clicked();
    callback cancel-clicked();
    callback confirmed();
    height: 30px;
    background: transparent;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.confirming ? parent.width - 204px : parent.width - 50px;
        height: parent.height;
        background: transparent;
        Text {
            x: 0px;
            y: 1px;
            width: parent.width;
            height: 14px;
            text: root.credit.title;
            color: Palette.foreground;
            font-size: 9.5px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: 0px;
            y: 14px;
            width: parent.width;
            height: 14px;
            text: root.credit.expiry;
            color: Palette.foreground;
            font-size: 8.5px;
            opacity: 0.56;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if !root.confirming: TinyAction {
        x: parent.width - 42px;
        y: 4px;
        width: 42px;
        text: "Use";
        active: !root.busy;
        clicked => { root.use-clicked(); }
    }
    if root.confirming: Text {
        x: parent.width - 198px;
        y: 0px;
        width: 88px;
        height: parent.height;
        text: "Confirm reset use?";
        color: Palette.foreground;
        font-size: 8.7px;
        opacity: 0.82;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.confirming: TinyAction {
        x: parent.width - 106px;
        y: 4px;
        width: 44px;
        text: "Cancel";
        active: !root.busy;
        clicked => { root.cancel-clicked(); }
    }
    if root.confirming: TinyAction {
        x: parent.width - 58px;
        y: 4px;
        width: 58px;
        text: "Use reset";
        emphasized: true;
        active: !root.busy;
        clicked => { root.confirmed(); }
    }
}

component AccountRow inherits Rectangle {
    in property <AccountView> account;
    in property <bool> blur-names: false;
    in property <bool> blur-emails: false;
    in property <bool> color-reset-timers: false;
    in property <string> usage-bar-color-mode: "account";
    in property <color> usage-bar-custom-color: #27bfce;
    in property <bool> motion-enabled: true;
    in property <bool> reset-busy: false;
    callback toggle-details(string);
    callback toggle-name(string);
    callback toggle-email(string);
    callback arm-reset(string, string);
    callback cancel-reset(string);
    callback confirm-reset(string, string);

    visible: root.account.enabled;
    height: root.account.enabled ? root.account.row-height-px * 1px : 0px;
    background: transparent;

    function usage-bar-color(remaining: float) -> color {
        if (root.usage-bar-color-mode == "remaining") {
            return hsv(120 * min(1, max(0, remaining)), 0.78, 0.95);
        }
        if (root.usage-bar-color-mode == "custom") {
            return root.usage-bar-custom-color;
        }
        return root.account.accent;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height - 1px;
        padding-top: 5px;
        padding-bottom: 6px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;

        HorizontalLayout {
            height: 22px;
            spacing: 7px;
            ProviderMark {
                provider-id: root.account.provider-id;
                accent: root.account.accent;
                show-accent: root.account.show-accent;
            }
            Rectangle {
                width: min(132px, name-text.preferred-width);
                height: 22px;
                background: transparent;
                accessible-role: button;
                accessible-label: root.blur-names && !root.account.name-revealed
                    ? "Reveal account name"
                    : root.account.display-name;
                name-text := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.blur-names && !root.account.name-revealed
                        ? root.account.masked-display-name
                        : root.account.display-name;
                    color: Palette.foreground;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    clicked => { if (root.blur-names) { root.toggle-name(root.account.id); } }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 22px;
                background: transparent;
                accessible-role: button;
                accessible-label: root.blur-emails && !root.account.email-revealed
                    ? "Reveal account email"
                    : root.account.email;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.blur-emails && !root.account.email-revealed
                        ? root.account.masked-email
                        : root.account.email;
                    color: Palette.foreground;
                    font-size: 9.5px;
                    opacity: root.blur-emails && !root.account.email-revealed ? 0.48 : 0.56;
                    overflow: elide;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { if (root.blur-emails) { root.toggle-email(root.account.id); } }
                }
            }
            if root.account.has-hidden-details: Rectangle {
                width: 26px;
                height: 26px;
                background: area.has-hover ? Palette.alternate-background : transparent;
                border-radius: 5px;
                accessible-role: button;
                accessible-label: root.account.expanded ? "Hide account details" : "Show account details";
                accessible-expandable: true;
                accessible-expanded: root.account.expanded;
                accessible-action-default => { root.toggle-details(root.account.id); }
                Chevron {
                    x: 1px;
                    y: 1px;
                    expanded: root.account.expanded;
                    motion-enabled: root.motion-enabled;
                }
                area := TouchArea { clicked => { root.toggle-details(root.account.id); } }
            }
        }

        if root.account.has-usage: LimitLine {
            label: root.account.long-label;
            remaining: root.account.long-remaining;
            percent-text: root.account.long-percent-text;
            accent: root.usage-bar-color(root.account.long-remaining);
            reset-text: root.account.long-reset-text;
            reset-color: root.account.long-reset-color;
            show-reset-text: root.account.expanded && root.account.has-long-reset-time;
            color-reset-timer: root.color-reset-timers;
        }
        if !root.account.has-usage: Text {
            height: 18px;
            text: root.account.error-text == "" ? "Checking usage…" : root.account.error-text;
            color: Palette.foreground;
            font-size: 9.5px;
            opacity: 0.55;
            vertical-alignment: center;
        }
        if root.account.has-usage && root.account.has-error: Text {
            height: 18px;
            text: root.account.error-text;
            color: Palette.foreground;
            font-size: 9.5px;
            opacity: 0.62;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.account.pin-short && root.account.has-short-limit: LimitLine {
            label: root.account.short-label;
            remaining: root.account.short-remaining;
            percent-text: root.account.short-percent-text;
            accent: root.usage-bar-color(root.account.short-remaining);
            reset-text: root.account.short-reset-text;
            reset-color: root.account.short-reset-color;
            show-reset-text: root.account.expanded && root.account.has-short-reset-time;
            color-reset-timer: root.color-reset-timers;
        }

        Rectangle {
            height: root.account.expanded ? root.account.detail-height-px * 1px : 0px;
            background: transparent;
            clip: true;
            VerticalLayout {
                width: parent.width;
                padding-bottom: root.account.reset-credits.length > 0 ? 9px : 5px;
                spacing: 1px;

                if !root.account.pin-short && root.account.has-short-limit: LimitLine {
                    label: root.account.short-label;
                    remaining: root.account.short-remaining;
                    percent-text: root.account.short-percent-text;
                    accent: root.usage-bar-color(root.account.short-remaining);
                    reset-text: root.account.short-reset-text;
                    reset-color: root.account.short-reset-color;
                    show-reset-text: root.account.has-short-reset-time;
                    color-reset-timer: root.color-reset-timers;
                }

                if root.account.has-reset-credits: DetailLine {
                    label: "Reset credits";
                    value: root.account.reset-count-text;
                }

                if root.account.reset-credits.length > 0: Rectangle {
                    height: 3px;
                    background: transparent;
                }

                for credit in root.account.reset-credits: ResetCreditRow {
                    credit: credit;
                    confirming: root.account.confirm-credit-id == credit.id;
                    busy: root.reset-busy;
                    use-clicked => { root.arm-reset(root.account.id, credit.id); }
                    cancel-clicked => { root.cancel-reset(root.account.id); }
                    confirmed => { root.confirm-reset(root.account.id, credit.id); }
                }
            }
        }
    }

    Rectangle {
        x: 10px;
        y: parent.height - 1px;
        width: parent.width - 20px;
        height: 1px;
        background: Palette.border;
        opacity: 0.55;
    }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked: false;
    callback changed(bool);
    height: 45px;
    background: transparent;
    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 8px;
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Text {
                text: root.title;
                color: Palette.foreground;
                font-size: 11px;
                vertical-alignment: bottom;
            }
            Text {
                text: root.subtitle;
                color: Palette.foreground;
                font-size: 8.5px;
                opacity: 0.55;
                vertical-alignment: top;
            }
        }
        AppSwitch {
            width: 38px;
            label: root.title;
            checked: root.checked;
            toggled => { root.changed(self.checked); }
        }
    }
}

component ColorChoiceButton inherits Rectangle {
    in property <ColorChoice> choice;
    in property <bool> selected: false;
    callback clicked(string);
    width: 20px;
    height: 24px;
    background: transparent;
    accessible-role: button;
    accessible-label: "Use " + root.choice.name + " account color";
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(root.choice.name); }

    Rectangle {
        x: 2px;
        y: 4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.choice.value;
        border-width: root.selected ? 3px : 1px;
        border-color: root.selected ? Palette.foreground : Palette.border;
    }
    TouchArea { clicked => { root.clicked(root.choice.name); } }
}

component CustomColorButton inherits Rectangle {
    in property <color> value;
    in property <bool> selected: false;
    callback clicked();
    width: 24px;
    height: 24px;
    background: area.has-hover ? Palette.alternate-background : transparent;
    border-radius: 5px;
    accessible-role: button;
    accessible-label: "Choose a custom account color";
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        x: 4px;
        y: 4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.value;
        border-width: root.selected ? 3px : 1px;
        border-color: root.selected ? Palette.foreground : Palette.border;
    }
    Text {
        x: 15px;
        y: 10px;
        width: 8px;
        height: 10px;
        text: "+";
        color: Palette.foreground;
        font-size: 8px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component HsvColorPicker inherits Rectangle {
    in-out property <float> hue: 180;
    in-out property <float> saturation: 1;
    in-out property <float> value: 1;
    callback picked(color);
    height: 94px;
    background: transparent;

    function update-saturation-value(x: length, y: length) {
        root.saturation = max(0, min(1, x / saturation-value.width));
        root.value = max(0, min(1, 1 - y / saturation-value.height));
    }

    function update-hue(x: length) {
        root.hue = max(0, min(359.99, x / hue-strip.width * 360));
    }

    saturation-value := Rectangle {
        x: 50px;
        y: 4px;
        width: parent.width - 50px;
        height: 66px;
        border-radius: 4px;
        clip: true;
        background: @linear-gradient(90deg, white 0%, hsv(root.hue, 1, 1) 100%);
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
        }
        Rectangle {
            x: root.saturation * parent.width - 4px;
            y: (1 - root.value) * parent.height - 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: transparent;
            border-width: 1.5px;
            border-color: white;
        }
        sv-area := TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind != PointerEventKind.cancel) {
                    root.update-saturation-value(self.mouse-x, self.mouse-y);
                    if (event.kind == PointerEventKind.up) {
                        root.picked(hsv(root.hue, root.saturation, root.value));
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    root.update-saturation-value(self.mouse-x, self.mouse-y);
                }
            }
        }
    }

    hue-strip := Rectangle {
        x: 50px;
        y: 78px;
        width: parent.width - 50px;
        height: 12px;
        border-radius: 4px;
        clip: true;
        background: @linear-gradient(90deg,
            #ef4444 0%, #eab308 16.7%, #22c55e 33.3%, #27bfce 50%,
            #3b82f6 66.7%, #8c6dd8 83.3%, #ef4444 100%);
        Rectangle {
            x: root.hue / 360 * parent.width - 2px;
            y: 0px;
            width: 4px;
            height: parent.height;
            background: white;
            border-width: 1px;
            border-color: #111111;
        }
        hue-area := TouchArea {
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind != PointerEventKind.cancel) {
                    root.update-hue(self.mouse-x);
                    if (event.kind == PointerEventKind.up) {
                        root.picked(hsv(root.hue, root.saturation, root.value));
                    }
                }
            }
            moved => {
                if (self.pressed) { root.update-hue(self.mouse-x); }
            }
        }
    }

    Rectangle {
        x: 4px;
        y: 4px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: hsv(root.hue, root.saturation, root.value);
        border-width: 1px;
        border-color: Palette.border;
    }
    Text {
        x: 0px;
        y: 43px;
        width: 42px;
        height: 26px;
        text: "Custom";
        color: Palette.foreground;
        font-size: 8px;
        opacity: 0.58;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component UsageBarModeButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();
    height: 27px;
    horizontal-stretch: 1;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.selected ? Palette.foreground : Palette.border;
    background: root.selected ? Palette.alternate-background : area.has-hover ? #ffffff0b : transparent;
    accessible-role: button;
    accessible-label: root.label + " usage bar colors";
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.label;
        color: Palette.foreground;
        font-size: 9px;
        font-weight: root.selected ? 600 : 400;
        opacity: root.selected ? 0.95 : 0.62;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component UsageBarColorSettings inherits Rectangle {
    in property <string> mode: "account";
    in property <color> custom-color: #27bfce;
    callback mode-changed(string);
    callback custom-color-changed(color);
    in-out property <float> picker-hue: root.custom-color.to-hsv().hue;
    in-out property <float> picker-saturation: root.custom-color.to-hsv().saturation;
    in-out property <float> picker-value: root.custom-color.to-hsv().value;
    height: root.mode == "custom" ? 158px : 64px;
    background: transparent;

    VerticalLayout {
        spacing: 3px;
        Text {
            height: 20px;
            text: "Usage bar colors";
            color: Palette.foreground;
            font-size: 11px;
            vertical-alignment: bottom;
        }
        HorizontalLayout {
            height: 31px;
            spacing: 5px;
            UsageBarModeButton {
                label: "Account";
                selected: root.mode == "account";
                clicked => { root.mode-changed("account"); }
            }
            UsageBarModeButton {
                label: "Green → red";
                selected: root.mode == "remaining";
                clicked => { root.mode-changed("remaining"); }
            }
            UsageBarModeButton {
                label: "Custom";
                selected: root.mode == "custom";
                clicked => { root.mode-changed("custom"); }
            }
        }
        if root.mode == "custom": HsvColorPicker {
            hue: root.picker-hue;
            saturation: root.picker-saturation;
            value: root.picker-value;
            picked(value) => { root.custom-color-changed(value); }
        }
    }
}

component AccountSettings inherits Rectangle {
    in property <AccountView> account;
    in property <[ColorChoice]> colors;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    callback name-changed(string, string);
    callback color-changed(string, string);
    callback custom-color-changed(string, color);
    callback enabled-changed(string, bool);
    callback pin-short-changed(string, bool);
    callback move-requested(string, int);
    private property <bool> picker-open: false;
    in-out property <float> picker-hue: root.account.account-color.to-hsv().hue;
    in-out property <float> picker-saturation: root.account.account-color.to-hsv().saturation;
    in-out property <float> picker-value: root.account.account-color.to-hsv().value;
    height: (root.account.has-short-limit ? 167px : 122px) + (root.picker-open ? 98px : 0px);
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        Rectangle {
            height: 46px;
            background: transparent;
            Text {
                x: 0px;
                y: 4px;
                width: parent.width - 122px;
                height: 20px;
                text: root.account.display-name;
                color: Palette.foreground;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 0px;
                y: 23px;
                width: parent.width - 122px;
                height: 16px;
                text: root.account.email == "" ? root.account.id : root.account.email;
                color: Palette.foreground;
                font-size: 8.5px;
                opacity: 0.55;
                vertical-alignment: center;
                overflow: elide;
            }
            TinyAction {
                x: parent.width - 116px;
                y: 12px;
                width: 25px;
                text: "↑";
                active: root.can-move-up;
                clicked => { root.move-requested(root.account.id, -1); }
            }
            TinyAction {
                x: parent.width - 87px;
                y: 12px;
                width: 25px;
                text: "↓";
                active: root.can-move-down;
                clicked => { root.move-requested(root.account.id, 1); }
            }
            AppSwitch {
                x: parent.width - 42px;
                y: 7px;
                width: 38px;
                label: "Enable " + root.account.display-name;
                checked: root.account.enabled;
                toggled => { root.enabled-changed(root.account.id, self.checked); }
            }
        }
        HorizontalLayout {
            height: 40px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;
            Text {
                width: 48px;
                text: "Name";
                color: Palette.foreground;
                font-size: 10px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 160px;
                height: 32px;
                background: transparent;
                LineEdit {
                    y: 2px;
                    width: parent.width;
                    height: 28px;
                    text: root.account.display-name;
                    placeholder-text: "Account name";
                    edited(value) => { root.name-changed(root.account.id, value); }
                }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        HorizontalLayout {
            height: 36px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;
            Text {
                width: 48px;
                text: "Color";
                color: Palette.foreground;
                font-size: 10px;
                vertical-alignment: center;
            }
            for choice in root.colors: ColorChoiceButton {
                choice: choice;
                selected: root.account.color-name == choice.name;
                clicked(name) => {
                    root.picker-open = false;
                    root.color-changed(root.account.id, name);
                }
            }
            CustomColorButton {
                value: root.account.account-color;
                selected: root.account.custom-color;
                clicked => { root.picker-open = !root.picker-open; }
            }
        }
        if root.picker-open: HsvColorPicker {
            hue: root.picker-hue;
            saturation: root.picker-saturation;
            value: root.picker-value;
            picked(value) => { root.custom-color-changed(root.account.id, value); }
        }
        if root.account.has-short-limit: SettingRow {
            title: "Show " + root.account.short-label;
            subtitle: "Keep this window below the main usage bar";
            checked: root.account.pin-short;
            changed(value) => { root.pin-short-changed(root.account.id, value); }
        }
    }
}

component MobileActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 28px;
    min-width: 72px;
    horizontal-stretch: 1;
    border-radius: 5px;
    border-width: 1px;
    border-color: Palette.border;
    background: root.primary ? Palette.foreground : area.has-hover ? Palette.alternate-background : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.label;
        color: root.primary ? Palette.background : Palette.foreground;
        font-size: 9px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

component MobileCompanionSettings inherits Rectangle {
    in-out property <bool> enabled;
    in-out property <bool> allow-lan;
    in property <string> status;
    in property <string> lan-url;
    in property <string> tailscale-url;
    in property <string> pairing-link;
    in property <[MobileDeviceView]> devices;
    in property <[QrCell]> qr-cells;
    callback enabled-changed(bool);
    callback allow-lan-changed(bool);
    callback create-pairing();
    callback copy-pairing();
    callback configure-tailscale();
    callback revoke-device(string);
    height: root.enabled
        ? (root.pairing-link == "" ? 199px : 379px) + root.devices.length * 38px
        : 58px;
    background: transparent;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 4px;
        SettingRow {
            title: "Phone companion";
            subtitle: root.enabled ? root.status : "Keep usage private and view-only on your phone";
            checked: root.enabled;
            changed(value) => { root.enabled-changed(value); }
        }
        if root.enabled: Text {
            height: 16px;
            text: !root.allow-lan
                ? "LAN · access off"
                : root.lan-url == "" ? "LAN address unavailable" : "LAN · " + root.lan-url;
            color: Palette.foreground;
            font-size: 8.5px;
            opacity: 0.62;
            overflow: elide;
        }
        if root.enabled: SettingRow {
            title: "Allow direct LAN";
            subtitle: "Otherwise listen only on this computer for Tailscale Serve";
            checked: root.allow-lan;
            changed(value) => { root.allow-lan-changed(value); }
        }
        if root.enabled: Text {
            height: 16px;
            text: root.tailscale-url == "" ? "Tailscale · not detected" : "Tailscale · " + root.tailscale-url;
            color: Palette.foreground;
            font-size: 8.5px;
            opacity: 0.62;
            overflow: elide;
        }
        if root.enabled: HorizontalLayout {
            height: 30px;
            spacing: 6px;
            MobileActionButton {
                label: "Pair a phone";
                primary: true;
                clicked => { root.create-pairing(); }
            }
            MobileActionButton {
                label: "Set up Tailscale";
                clicked => { root.configure-tailscale(); }
            }
        }
        if root.enabled && root.pairing-link != "": HorizontalLayout {
            height: 166px;
            spacing: 10px;
            Rectangle {
                width: 156px;
                height: 156px;
                background: white;
                border-radius: 5px;
                for cell in root.qr-cells: Rectangle {
                    x: cell.x * 1px;
                    y: cell.y * 1px;
                    width: cell.size * 1px;
                    height: cell.size * 1px;
                    background: black;
                }
            }
            VerticalLayout {
                spacing: 5px;
                Text {
                    text: "Scan with your phone camera";
                    color: Palette.foreground;
                    font-size: 10px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    vertical-stretch: 1;
                    text: "This link expires in 10 minutes and can pair only the displayed LAN/Tailscale addresses.";
                    color: Palette.foreground;
                    font-size: 8.5px;
                    opacity: 0.6;
                    wrap: word-wrap;
                }
                MobileActionButton {
                    label: "Copy private link";
                    clicked => { root.copy-pairing(); }
                }
            }
        }
        if root.enabled && root.devices.length > 0: Text {
            height: 18px;
            text: "Paired phones";
            color: Palette.foreground;
            font-size: 9px;
            font-weight: 600;
            opacity: 0.58;
            vertical-alignment: bottom;
        }
        for device in root.devices: HorizontalLayout {
            height: 34px;
            spacing: 6px;
            VerticalLayout {
                vertical-stretch: 1;
                Text { text: device.name; color: Palette.foreground; font-size: 9.5px; vertical-alignment: bottom; }
                Text { text: device.detail; color: Palette.foreground; font-size: 8px; opacity: 0.52; vertical-alignment: top; }
            }
            MobileActionButton {
                width: 58px;
                horizontal-stretch: 0;
                label: "Revoke";
                clicked => { root.revoke-device(device.id); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Agents Usage";
    width: 360px;
    height: root.desired-height-px * 1px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <[AccountView]> accounts;
    in-out property <bool> settings-visible: false;
    in-out property <bool> blur-names: false;
    in-out property <bool> blur-emails: false;
    in-out property <bool> color-reset-timers: false;
    in-out property <string> usage-bar-color-mode: "account";
    in-out property <color> usage-bar-custom-color: #27bfce;
    in-out property <bool> pin-short-global: false;
    in-out property <bool> motion-enabled: true;
    in-out property <bool> refreshing: false;
    in-out property <bool> reset-busy: false;
    in-out property <float> desired-height-px: 180;
    in-out property <float> dashboard-height-px: 180;
    in-out property <float> settings-height-px: 180;
    in property <string> accounts-summary: "";
    in property <string> empty-text: "Looking for accounts…";
    in property <int> enabled-account-count: 0;
    in-out property <bool> mobile-enabled: false;
    in-out property <bool> mobile-allow-lan: false;
    in-out property <string> mobile-status: "Disabled";
    in-out property <string> mobile-lan-url: "";
    in-out property <string> mobile-tailscale-url: "";
    in-out property <string> mobile-pairing-link: "";
    in property <[MobileDeviceView]> mobile-devices;
    in property <[QrCell]> mobile-qr-cells;

    callback refresh-requested();
    callback settings-requested();
    callback back-to-dashboard();
    callback account-toggle-details(string);
    callback account-toggle-name(string);
    callback account-toggle-email(string);
    callback account-arm-reset(string, string);
    callback account-cancel-reset(string);
    callback account-confirm-reset(string, string);
    callback blur-emails-changed(bool);
    callback blur-names-changed(bool);
    callback color-reset-timers-changed(bool);
    callback usage-bar-color-mode-changed(string);
    callback usage-bar-custom-color-changed(color);
    callback pin-short-global-changed(bool);
    callback account-enabled-changed(string, bool);
    callback account-pin-short-changed(string, bool);
    callback account-name-changed(string, string);
    callback account-color-changed(string, string);
    callback account-custom-color-changed(string, color);
    callback account-move-requested(string, int);
    callback mobile-enabled-changed(bool);
    callback mobile-allow-lan-changed(bool);
    callback mobile-create-pairing();
    callback mobile-copy-pairing();
    callback mobile-configure-tailscale();
    callback mobile-revoke-device(string);

    private property <[ColorChoice]> account-colors: [
        { name: "red", value: #ef4444 },
        { name: "orange", value: #f97316 },
        { name: "yellow", value: #eab308 },
        { name: "green", value: #22c55e },
        { name: "cyan", value: #27bfce },
        { name: "blue", value: #3b82f6 },
        { name: "purple", value: #8c6dd8 },
        { name: "pink", value: #ec4899 },
        { name: "gray", value: #9ca3af },
        { name: "black", value: #141414 },
    ];

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.background;
        clip: true;

        if !root.settings-visible: VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;

            Rectangle {
                height: 40px;
                background: transparent;
                Image {
                    x: 12px;
                    y: 11px;
                    width: 18px;
                    height: 18px;
                    source: @image-url("../assets/icons/bot.svg");
                    colorize: Palette.foreground;
                    image-fit: contain;
                }
                Text {
                    x: 38px;
                    y: 0px;
                    width: parent.width - 112px;
                    height: 40px;
                    text: "Agents usage";
                    color: Palette.foreground;
                    font-size: 12.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                HeaderIconButton {
                    x: parent.width - 68px;
                    y: 5px;
                    icon: @image-url("../assets/icons/settings-2.svg");
                    icon-size: 18px;
                    label: "Settings";
                    clicked => { root.settings-requested(); }
                }
                HeaderIconButton {
                    x: parent.width - 34px;
                    y: 5px;
                    icon: @image-url("../assets/icons/refresh-cw.svg");
                    icon-size: 18px;
                    label: root.refreshing ? "Refreshing" : "Refresh";
                    active: !root.refreshing;
                    clicked => { root.refresh-requested(); }
                }
            }
            Rectangle { height: 1px; background: Palette.border; opacity: 0.55; }

            if root.enabled-account-count == 0: Text {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                text: root.empty-text;
                color: Palette.foreground;
                font-size: 10px;
                opacity: 0.55;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            if root.enabled-account-count > 0: ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                mouse-drag-pan-enabled: false;

                VerticalLayout {
                    width: parent.width;
                    padding-bottom: 17px;
                    spacing: 0px;
                    for account in root.accounts: AccountRow {
                        account: account;
                        blur-names: root.blur-names;
                        blur-emails: root.blur-emails;
                        color-reset-timers: root.color-reset-timers;
                        usage-bar-color-mode: root.usage-bar-color-mode;
                        usage-bar-custom-color: root.usage-bar-custom-color;
                        motion-enabled: root.motion-enabled;
                        reset-busy: root.reset-busy;
                        toggle-details(id) => { root.account-toggle-details(id); }
                        toggle-name(id) => { root.account-toggle-name(id); }
                        toggle-email(id) => { root.account-toggle-email(id); }
                        arm-reset(id, credit) => { root.account-arm-reset(id, credit); }
                        cancel-reset(id) => { root.account-cancel-reset(id); }
                        confirm-reset(id, credit) => { root.account-confirm-reset(id, credit); }
                    }
                }
            }
        }

        if root.settings-visible: VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0px;
            Rectangle {
                height: 40px;
                background: transparent;
                HeaderIconButton {
                    x: 7px;
                    y: 5px;
                    icon: @image-url("../assets/icons/chevron-left.svg");
                    icon-size: 18px;
                    label: "Back to usage";
                    clicked => {
                        root.settings-visible = false;
                        root.back-to-dashboard();
                    }
                }
                Text {
                    x: 43px;
                    y: 0px;
                    width: parent.width - 53px;
                    height: 40px;
                    text: "Settings";
                    color: Palette.foreground;
                    font-size: 12.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: Palette.border; opacity: 0.55; }

            settings-scroll := ScrollView {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                mouse-drag-pan-enabled: false;

                VerticalLayout {
                    width: parent.width;
                    padding-top: 8px;
                    padding-left: 10px;
                    padding-right: 14px;
                    padding-bottom: 10px;
                    spacing: 0px;

                        SettingRow {
                            title: "Blur account emails";
                            subtitle: "When enabled, click an email to reveal it";
                            checked: root.blur-emails;
                            changed(value) => { root.blur-emails-changed(value); }
                        }
                        SettingRow {
                            title: "Blur account names";
                            subtitle: "When enabled, click a name to reveal it";
                            checked: root.blur-names;
                            changed(value) => { root.blur-names-changed(value); }
                        }
                        SettingRow {
                            title: "Color reset timers";
                            subtitle: "Fade timers from red toward green as reset nears";
                            checked: root.color-reset-timers;
                            changed(value) => { root.color-reset-timers-changed(value); }
                        }
                        SettingRow {
                            title: "Always show 5-hour limits";
                            subtitle: "Show available short windows below weekly usage";
                            checked: root.pin-short-global;
                            changed(value) => { root.pin-short-global-changed(value); }
                        }
                        UsageBarColorSettings {
                            mode: root.usage-bar-color-mode;
                            custom-color: root.usage-bar-custom-color;
                            mode-changed(value) => { root.usage-bar-color-mode-changed(value); }
                            custom-color-changed(value) => { root.usage-bar-custom-color-changed(value); }
                        }
                        MobileCompanionSettings {
                            enabled: root.mobile-enabled;
                            allow-lan: root.mobile-allow-lan;
                            status: root.mobile-status;
                            lan-url: root.mobile-lan-url;
                            tailscale-url: root.mobile-tailscale-url;
                            pairing-link: root.mobile-pairing-link;
                            devices: root.mobile-devices;
                            qr-cells: root.mobile-qr-cells;
                            enabled-changed(value) => { root.mobile-enabled-changed(value); }
                            allow-lan-changed(value) => { root.mobile-allow-lan-changed(value); }
                            create-pairing => { root.mobile-create-pairing(); }
                            copy-pairing => { root.mobile-copy-pairing(); }
                            configure-tailscale => { root.mobile-configure-tailscale(); }
                            revoke-device(id) => { root.mobile-revoke-device(id); }
                        }
                        Text {
                            height: 22px;
                            text: "Accounts";
                            color: Palette.foreground;
                            font-size: 9px;
                            font-weight: 600;
                            opacity: 0.58;
                            vertical-alignment: bottom;
                        }

                        for account[index] in root.accounts: AccountSettings {
                            account: account;
                            colors: root.account-colors;
                            can-move-up: index > 0;
                            can-move-down: index + 1 < root.accounts.length;
                            name-changed(id, value) => { root.account-name-changed(id, value); }
                            color-changed(id, value) => { root.account-color-changed(id, value); }
                            custom-color-changed(id, value) => { root.account-custom-color-changed(id, value); }
                            enabled-changed(id, value) => { root.account-enabled-changed(id, value); }
                            pin-short-changed(id, value) => { root.account-pin-short-changed(id, value); }
                            move-requested(id, direction) => { root.account-move-requested(id, direction); }
                        }

                        Text {
                            height: 28px;
                            text: root.accounts-summary;
                            color: Palette.foreground;
                            font-size: 8.5px;
                            opacity: 0.48;
                            vertical-alignment: center;
                        }
                }
            }
        }
    }
}
